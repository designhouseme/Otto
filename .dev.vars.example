# Skopiuj do .dev.vars (plik jest w .gitignore). Na produkcji te same nazwy ustawiasz przez
#   npx wrangler secret put NAZWA

# 1 = nic nie wychodzi do Telegrama: wywołania lądują w konsoli `wrangler dev`.
DEV_DRY_RUN=1

# Telegram: token od @BotFather, nazwa bota bez @ i dowolny długi ciąg do podpisu webhooka.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Klucz Gemini na darmowe wiadomości i rozmowę na stronie (Google AI Studio).
GEMINI_API_KEY=

# Szyfrowanie kluczy użytkowników i hashowanie numerów czatów. Długie, losowe, raz ustawione.
KEY_SECRET=
HASH_PEPPER=

# Polecenia /admin/* (nagłówek Authorization: Bearer ...).
ADMIN_TOKEN=

# Numery kont Telegram adminów, po przecinku. Oni mogą w bocie dawać VIP: /vip NUMER. Numer daje /id.
ADMIN_CHAT_IDS=

# Opcjonalnie: numer konta Telegram właściciela zestawu naklejek Otto.
STICKER_OWNER_ID=
