/**
 * Otto: osobisty asystent na Telegramie.
 *
 * Jeden Worker: strona z `public/`, webhook Telegrama (`/tg/webhook`),
 * rozmowa z Ottem na stronie (`/api/ask`) i kilka poleceń administracyjnych (`/admin/*`).
 * Dane: Durable Objects. `Chat` to jeden obiekt na jedną osobę (stan, przypomnienia, alarm),
 * `Registry` to jeden wspólny obiekt (odebrane pakiety, zgody na kontakt, dzienne limity).
 *
 * Sekrety i adresy konkretnej instancji ustawiasz przez `wrangler secret put` (lista w README),
 * a lokalnie w `.dev.vars` (wzór: `.dev.vars.example`).
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otto",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Własna domena tej instancji (strefa musi być na tym samym koncie Cloudflare).
  // U siebie wpisz swoją albo usuń ten wpis: wtedy Otto działa pod adresem workers.dev.
  "routes": [{ "pattern": "otto.designhouse.me", "custom_domain": true }],

  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": ["/tg/*", "/api/*", "/admin/*", "/telegram"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "Chat" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Chat", "Registry"] }],

  "vars": {
    // Alias zawsze wskazuje aktualny model Flash. Konkretną wersję wpiszesz tutaj.
    "GEMINI_MODEL": "gemini-flash-latest",
    // Gdy główny model jest przeciążony (503), Otto raz ponawia na lżejszym.
    "GEMINI_FALLBACK_MODEL": "gemini-flash-lite-latest",
    // Darmowe wiadomości AI na jedną osobę (po potwierdzeniu maila).
    "FREE_MESSAGES": "10",
    // Bezpiecznik kosztów: łączna liczba darmowych wiadomości AI na dobę, w bocie i na stronie.
    "DAILY_FREE_LIMIT": "1000",
    "SITE_DAILY_LIMIT": "1500",
    "DEFAULT_TZ": "Europe/Warsaw",
    "MAIL_FROM_NAME": "Otto",
    // Dokąd prowadzi przycisk „Bot dla firmy”.
    "COMPANY_URL": "https://designhouse.me/automatyzacje"
  },

  "observability": { "enabled": true }
}
